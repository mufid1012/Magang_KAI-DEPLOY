DATABASE_URL="mysql://user:password@localhost:3306/ppj_kai"
PORT=5001
NODE_ENV=development

# Generate a unique secret for every environment, for example with:
# openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# Comma-separated when more than one frontend origin is required.
FRONTEND_URL="http://localhost:3000"

# Secure by default. Only enable temporarily in an isolated test environment.
TRACKING_BYPASS_ENABLED=false
TRUST_PROXY_HOPS=0
