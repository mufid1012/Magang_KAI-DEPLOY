generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int           @id @default(autoincrement())
  nipp               String        @unique @db.VarChar(20)
  nama               String        @db.VarChar(100)
  password           String        @db.VarChar(255)
  foto               String?       @db.Text
  role               String        @default("ppj") @db.VarChar(20) // admin | qc | kupt | guest | ppj
  jabatan            String?       @db.VarChar(100) // e.g. "Track Inspector"
  division           String?       @db.VarChar(100) // e.g. "DAOP 1 Jakarta"
  workArea           String?       @map("work_area") @db.VarChar(100) // e.g. "Sektor 4 (GMR-JAKK)"
  phone              String?       @db.VarChar(30) // e.g. "+62 812-3456-7890"
  alertSound         String?       @map("alert_sound") @db.VarChar(20) // siren | beep | chime | off
  isActive           Boolean       @default(true) @map("is_active")
  managerId          Int?          @map("manager_id") // ID of the admin who manages this petugas
  tugasPpj           TugasPpj[]
  wilayahAssignments UserWilayah[]
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Self-relation
  manager           User?           @relation("ManagerPetugas", fields: [managerId], references: [id])
  petugasManaged    User[]          @relation("ManagerPetugas")
  mapLocations      MapLocation[]
  trainSchedules    TrainSchedule[] @relation("TrainScheduleCreator")
  approvedTrackings Tracking[]      @relation("TrackingApprover")
  warningAlerts     WarningAlert[]

  @@map("users")
}

model MapLocation {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  address     String?  @db.Text
  description String?  @db.Text
  latitude    Float
  longitude   Float
  createdBy   Int      @map("created_by")
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("map_locations")
}

model LoginPhoto {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(150)
  image     Bytes    @db.LongBlob
  mimeType  String   @map("mime_type") @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("login_photos")
}

model TugasPpj {
  id             Int        @id @default(autoincrement())
  jalur          String     @db.VarChar(200)
  tanggal        DateTime   @db.Date
  startPointLat  Float      @map("start_point_lat")
  startPointLong Float      @map("start_point_long")
  endPointLat    Float      @map("end_point_lat")
  endPointLong   Float      @map("end_point_long")
  startPointName String?    @map("start_point_name") @db.VarChar(200)
  endPointName   String?    @map("end_point_name") @db.VarChar(200)
  jamMulai       String?    @map("jam_mulai") @db.VarChar(10) // e.g. "08:00"
  jamSelesai     String?    @map("jam_selesai") @db.VarChar(10) // e.g. "16:00"
  assignedTo     Int        @map("assigned_to")
  status         String     @default("pending") @db.VarChar(20) // pending | in_progress | need_approval | completed | cancelled | missed
  user           User       @relation(fields: [assignedTo], references: [id])
  tracking       Tracking[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("tugas_ppj")
}

model Tracking {
  id             Int       @id @default(autoincrement())
  tugasId        Int       @map("tugas_id")
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")
  startLat       Float?    @map("start_lat")
  startLong      Float?    @map("start_long")
  endLat         Float?    @map("end_lat")
  endLong        Float?    @map("end_long")
  durasi         Int?      @default(0)
  status         String    @default("started") @db.VarChar(20)
  fotoAwal       String?   @map("foto_awal") @db.LongText
  fotoSelesai    String?   @map("foto_selesai") @db.LongText
  routePath      String?   @map("route_path") @db.LongText // JSON: [[lat,lng], ...]
  approvalStatus String    @default("not_approved") @map("approval_status") @db.VarChar(20) // not_approved | approved
  safetyStatus   String    @default("aman") @map("safety_status") @db.VarChar(20) // aman | tidak_aman
  approvedAt     DateTime? @map("approved_at")
  approvedBy     Int?      @map("approved_by")
  approver       User?     @relation("TrackingApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  tugas          TugasPpj  @relation(fields: [tugasId], references: [id])
  laporan        Laporan[]
  warningRecipients WarningRecipient[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("tracking")
}

model TrainSchedule {
  id            Int      @id @default(autoincrement())
  trainCode     String   @unique @map("train_code") @db.VarChar(30)
  trainName     String   @map("train_name") @db.VarChar(100)
  origin        String   @db.VarChar(150)
  destination   String   @db.VarChar(150)
  departureTime String   @map("departure_time") @db.VarChar(5)
  arrivalTime   String   @map("arrival_time") @db.VarChar(5)
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     Int      @map("created_by")
  creator       User     @relation("TrainScheduleCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("train_schedules")
}

model WarningAlert {
  recipients WarningRecipient[]
  startPointName String? @map("start_point_name") @db.VarChar(200)
  endPointName   String? @map("end_point_name") @db.VarChar(200)
  id        Int      @id @default(autoincrement())
  createdBy Int      @map("created_by")
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([expiresAt])
  @@map("warning_alerts")
}

model WarningRecipient {
  id         Int          @id @default(autoincrement())
  warningId  Int          @map("warning_id")
  trackingId Int          @map("tracking_id")
  warning    WarningAlert @relation(fields: [warningId], references: [id], onDelete: Cascade)
  tracking   Tracking     @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@unique([warningId, trackingId])
  @@index([trackingId])
  @@map("warning_recipients")
}

model Laporan {
  id          Int      @id @default(autoincrement())
  trackingId  Int      @map("tracking_id")
  jenisTemuan String   @map("jenis_temuan") @db.VarChar(20)
  deskripsi   String   @db.Text
  foto        String?  @db.Text
  latitude    Float
  longitude   Float
  tracking    Tracking @relation(fields: [trackingId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("laporan")
}

model Wilayah {
  id       Int           @id @default(autoincrement())
  kode     String        @unique @db.VarChar(20) // "JR 6.1"
  nama     String        @db.VarChar(100) // "Jenar"
  stations String        @db.Text // JSON array: '["Sta. Jenar"]'
  users    UserWilayah[]

  @@map("wilayah")
}

model UserWilayah {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  wilayahId Int     @map("wilayah_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilayah   Wilayah @relation(fields: [wilayahId], references: [id], onDelete: Cascade)

  @@unique([userId, wilayahId])
  @@map("user_wilayah")
}

model TemplatePenugasan {
  id        Int            @id @default(autoincrement())
  nama      String         @db.VarChar(100)
  createdBy Int            @map("created_by")
  items     TemplateItem[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("template_penugasan")
}

model TemplateItem {
  id             Int               @id @default(autoincrement())
  templateId     Int               @map("template_id")
  assignedTo     Int               @map("assigned_to")
  startPointName String            @map("start_point_name") @db.VarChar(200)
  endPointName   String            @map("end_point_name") @db.VarChar(200)
  startPointLat  Float             @map("start_point_lat")
  startPointLong Float             @map("start_point_long")
  endPointLat    Float             @map("end_point_lat")
  endPointLong   Float             @map("end_point_long")
  jamMulai       String?           @map("jam_mulai") @db.VarChar(10)
  jamSelesai     String?           @map("jam_selesai") @db.VarChar(10)
  template       TemplatePenugasan @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_item")
}

model KategoriTemuan {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  label     String   @db.VarChar(100)
  icon      String   @db.VarChar(50)
  color     String   @default("primary") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("kategori_temuan")
}
